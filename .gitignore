# Defensive ignore list for a closed source showcase repo.
# This repo publishes writeups without publishing source, secrets or data.
# This list makes it hard to leak any of that by accident.

# Secrets and environment. Never commit these.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets*
credentials*
*token*
*apikey*
*api_key*

# Proprietary source (do not vendor the real implementations into this repo)
/hieuluat-src/
/gen-system-src/
# gen-system is Go; keep its source out of the showcase
*.go
# The Python snippets in /snippets are small and meant to be here. The real
# HieuLuat source should never go in this repo. Keep it in its private repo.

# Data: legal corpus, embeddings, eval inputs, dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
/data/
/bk_data/
/bk_data_2/
*.parquet
*.pkl
*.npy
*.npz
embeddings/
corpus/

# Build / deps / caches
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
.cache/
# local backups, never published
.bkup/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
